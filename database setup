import sqlite3

connection = sqlite3.connect('database.db')
connection.execute("PRAGMA foreign_keys = ON")
cursor = connection.cursor()

#Cria tabela professor
cursor.execute(
    """CREATE TABLE IF NOT EXISTS PROFESSOR (
    email VARCHAR(100) NOT NULL PRIMARY KEY,
    nome VARCHAR(80) NOT NULL,
    telefone VARCHAR(20),
    coordenacao VARCHAR(50)
        )
    """
)

#Cria tabela Coordenador/agente de apoio
cursor.execute(
    """CREATE TABLE IF NOT EXISTS COORDENADOR_E_AGENTE(
    email VARCHAR(100) NOT NULL PRIMARY KEY,
    nome VARCHAR(80) NOT NULL,
    eh_agente BOOLEAN NOT NULL
        )
    """
)

#Cria a tabela diretor
cursor.execute(
    """CREATE TABLE IF NOT EXISTS DIRETOR (
    email VARCHAR(100) NOT NULL PRIMARY KEY,
    nome VARCHAR(80) NOT NULL
            )
    """
)

#Cria tabela ponto
cursor.execute(
    """CREATE TABLE IF NOT EXISTS PONTO (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    data_criacao DATE NOT NULL,
    status VARCHAR(30) NOT NULL,
    tipo_ponto BOOLEAN NOT NULL,
    criador VARCHAR(100) NOT NULL,
    responsavel VARCHAR(100),
    FOREIGN KEY (criador) REFERENCES PROFESSOR (email),
    FOREIGN KEY (responsavel) REFERENCES COORDENADOR_E_AGENTE (email)
        )
    """
)

connection.commit()
connection.close()
