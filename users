#cria diretor
def create_diretor(name, email):
    diretor = {
        "name": name,
        "email": email
    }

    return diretor


#cria outros usuários
def create_user(name, email, role, telefone):
    user = {
        "name": name,
        "email": email,
        "role": role,
        "telefone": telefone
    }

    return user
